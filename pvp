RunService.RenderStepped:Connect(function()
    if walkSpeedEnabled then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = walkSpeedValue
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if invisEnabled then
        makeInvisible(char)
    end
    if flightEnabled and hrp and hum then
        hum.PlatformStand = true
        local cam = Workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
            dir = dir + Vector3.new(0, -1, 0)
        end
        if dir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = dir.Unit * flightSpeedValue
        else
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    else
        if hum then
            hum.PlatformStand = false
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if invisEnabled then makeInvisible(char) end
    if unbreakableEnabled then applyUnbreakable() end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if rebinding and activeRebindLabel then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local baseText = activeRebindLabel:GetAttribute("baseText") or "bind: "
        if input.KeyCode == Enum.KeyCode.Backspace then
            if activeRebindLabel == guiKeyLabel then guiBind = nil
            elseif activeRebindLabel == dashKeyLabel then dashBind = nil
            elseif activeRebindLabel == unbreakableKeyLabel then unbreakableBind = nil
            elseif activeRebindLabel == antiStunKeyLabel then antiStunBind = nil
            elseif activeRebindLabel == killAuraKeyLabel then killAuraBind = nil
            elseif activeRebindLabel == noClipKeyLabel then noClipBind = nil
            elseif activeRebindLabel == invisKeyLabel then invisBind = nil
            elseif activeRebindLabel == walkSpeedKeyLabel then walkSpeedBind = nil
            elseif activeRebindLabel == flightKeyLabel then flightBind = nil
            end
            activeRebindLabel.Text = baseText .. "unbound"
        else
            local newKey = input.KeyCode
            if activeRebindLabel == guiKeyLabel then guiBind = newKey
            elseif activeRebindLabel == dashKeyLabel then dashBind = newKey
            elseif activeRebindLabel == unbreakableKeyLabel then unbreakableBind = newKey
            elseif activeRebindLabel == antiStunKeyLabel then antiStunBind = newKey
            elseif activeRebindLabel == killAuraKeyLabel then killAuraBind = newKey
            elseif activeRebindLabel == noClipKeyLabel then noClipBind = newKey
            elseif activeRebindLabel == invisKeyLabel then invisBind = newKey
            elseif activeRebindLabel == walkSpeedKeyLabel then walkSpeedBind = newKey
            elseif activeRebindLabel == flightKeyLabel then flightBind = newKey
            end
            activeRebindLabel.Text = baseText .. newKey.Name
        end
        rebinding = false
        activeRebindLabel = nil
        return
    end
    if guiBind and input.KeyCode == guiBind then gui.Enabled = not gui.Enabled end
    if dashBind and input.KeyCode == dashBind then toggleDash() end
    if unbreakableBind and input.KeyCode == unbreakableBind then toggleUnbreakable() end
    if antiStunBind and input.KeyCode == antiStunBind then toggleAntiStun() end
    if killAuraBind and input.KeyCode == killAuraBind then toggleKillAura() end
    if noClipBind and input.KeyCode == noClipBind then toggleNoClip() end
    if invisBind and input.KeyCode == invisBind then toggleInvis() end
    if walkSpeedBind and input.KeyCode == walkSpeedBind then toggleWalkSpeed() end
    if flightBind and input.KeyCode == flightBind then toggleFlight() end
end)

local dragging = false
local dragStart, startPos
bar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = i.Position
        startPos = frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = i.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

