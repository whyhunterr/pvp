        if antiStunConnection then task.cancel(antiStunConnection) end
        antiStunConnection = task.spawn(function()
            while antiStunEnabled do
                task.wait(0.1)
                local char = LocalPlayer.Character
                if char then
                    local folder = char:FindFirstChild("AntiMover")
                    if not folder then
                        folder = Instance.new("Folder")
                        folder.Name = "AntiMover"
                        folder.Parent = char
                    end
                end
            end
        end)
    else
        antiStunToggle.Text = "ENABLE ANTI STUN"
        antiStunToggle.TextColor3 = Color3.fromRGB(210, 210, 210)
        if antiStunConnection then task.cancel(antiStunConnection) antiStunConnection = nil end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("AntiMover") then char.AntiMover:Destroy() end
    end
end

local RegisterHit, RegisterAttack
task.spawn(function()
    pcall(function()
        local net = ReplicatedStorage:WaitForChild("Modules", 10):WaitForChild("Net", 10)
        RegisterHit = net["RE/RegisterHit"]
        RegisterAttack = net["RE/RegisterAttack"]
    end)
end)

local function getTargets()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {} end
    local targets = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and (hrp.Position - myHRP.Position).Magnitude <= 2000 then
                table.insert(targets, char)
            end
        end
    end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, npc in pairs(enemiesFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and (hrp.Position - myHRP.Position).Magnitude <= 2000 then
                table.insert(targets, npc)
            end
        end
    end
    return targets
end

local function attackTargets(targets)
    if not RegisterHit or not RegisterAttack or #targets == 0 then return end
    pcall(function()
        local all = {}
        for _, c in pairs(targets) do
            local head = c:FindFirstChild("Head") or c:FindFirstChildWhichIsA("BasePart")
            if head then table.insert(all, {c, head}) end
        end
        if #all == 0 then return end
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(all[1][2], all)
    end)
end

local function toggleKillAura()
    kaEnabled = not kaEnabled
    if kaEnabled then
        killAuraToggle.Text = "DISABLE KILL AURA"
        killAuraToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
        if kaConnection then task.cancel(kaConnection) end
        kaConnection = task.spawn(function()
            while kaEnabled do
                task.wait(0.001)
                attackTargets(getTargets())
            end
        end)
    else
